#!/usr/bin/env python3
"""Theme switcher for hypr-rice (Super+T), in the style of Omarchy's.

A full-screen overlay over a dimmed desktop with a horizontal carousel: the
selected theme as a large slanted preview of its wallpaper, its neighbours
as narrow slanted slices fanning out to both sides, and the theme's name
underneath. Styled with the active theme's colors.

  Left/Right, Tab/Shift+Tab, mouse wheel   move
  Enter, click the large preview           apply (through `themectl`)
  click a slice                            select it
  type                                     filter by name (Backspace edits)
  Esc                                      clear the filter, then close
  click outside                            close

The last two cards are "match wallpaper" (palette from the current
wallpaper) and "surprise me" (random theme).

Fast startup: it runs as a resident service (`theme-picker --service`,
autostarted by Hyprland) with every preview pre-decoded, so later
invocations just show the window. Previews are cached cover-crops in
~/.cache/hypr-rice-thumbs.
"""
import hashlib
import json
import math
import os
import re
import subprocess
import sys
import time
from pathlib import Path

# gtk4-layer-shell has to be loaded before libwayland-client, which Python
# can't guarantee on its own -- re-exec once with it preloaded.
LAYER_LIB = "/usr/lib/libgtk4-layer-shell.so"
if (os.path.exists(LAYER_LIB) and "libgtk4-layer-shell" not in os.environ.get("LD_PRELOAD", "")
        and os.environ.get("GDK_BACKEND", "wayland") == "wayland" and "--apply" not in sys.argv):
    os.environ["LD_PRELOAD"] = (LAYER_LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable] + sys.argv)

HOME = Path.home()
BLUEPRINTS = HOME / ".config/aether/blueprints"
STATE = HOME / ".config/aether/current-theme"
THUMBS = HOME / ".cache/hypr-rice-thumbs"
CATEGORIES = HOME / ".config/hypr-rice/categories"
THEMECTL = HOME / ".local/bin/themectl"
WALL = HOME / "Pictures/wallpapers/wall.png"

# Omarchy's image-picker geometry
EXP_W, EXP_H = 768, 475          # selected preview
SLICE_W, SLICE_H = 108, 432      # neighbours
SPACING = -30                    # slices overlap
SKEW = 28                        # slant of every card
STEP = SLICE_W + SPACING
SLIDE_MS = 180                   # selection slide (Omarchy snaps; a short ease reads smoother)
FONT = "JetBrainsMono Nerd Font"

AUTO, RANDOM = "__auto__", "__random__"


def apply_theme(name):
    args = ["auto"] if name == AUTO else ["random"] if name == RANDOM else ["set", name]
    subprocess.Popen(["setsid", str(THEMECTL), *args],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if len(sys.argv) > 2 and sys.argv[1] == "--apply":
    apply_theme(sys.argv[2])
    sys.exit(0)

import cairo  # noqa: E402
import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango, PangoCairo  # noqa: E402

try:
    gi.require_version("Gtk4LayerShell", "1.0")
    from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402
except (ValueError, ImportError):
    LayerShell = None


def categories():
    cats = {}
    if CATEGORIES.exists():
        for line in CATEGORIES.read_text().splitlines():
            parts = line.split()
            if len(parts) >= 2 and not parts[0].startswith("#"):
                cats[parts[0]] = parts[1]
    return cats


def load_themes():
    """Game themes, then the rest, alphabetically; then the two extras."""
    cats = categories()
    themes = []
    for f in sorted(BLUEPRINTS.glob("*.json")):
        try:
            bp = json.loads(f.read_text())
        except ValueError:
            continue
        name = bp.get("name", f.stem)
        themes.append({"name": name, "label": name.replace("-", " "),
                       "kind": "game theme" if cats.get(name) == "games" else "theme",
                       "wallpaper": bp.get("palette", {}).get("wallpaper", ""),
                       "light": bp.get("palette", {}).get("lightMode", False)})
    themes.sort(key=lambda t: (t["kind"] != "game theme", t["name"]))
    themes.append({"name": AUTO, "label": "match wallpaper", "kind": "colors from the current wallpaper",
                   "wallpaper": str(WALL), "light": False})
    themes.append({"name": RANDOM, "label": "surprise me", "kind": "a random theme",
                   "wallpaper": str(WALL), "light": False})
    return themes


def palette():
    try:
        toml = (HOME / ".config/aether/theme/colors.toml").read_text()
    except OSError:
        toml = ""
    pal = dict(re.findall(r'^(\w+)\s*=\s*"([^"]*)"', toml, re.M))
    return {"bg": pal.get("background", "#111111"), "fg": pal.get("foreground", "#dddddd"),
            "accent": pal.get("accent", "#d4a017"), "muted": pal.get("muted", "#555555")}


def rgb(hexcol):
    h = hexcol.lstrip("#")
    try:
        return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except ValueError:
        return (0.5, 0.5, 0.5)


def preview_path(wall):
    """Cover-cropped EXP_W x EXP_H preview, cached by path + mtime."""
    src = Path(wall).resolve() if wall else None
    if not src or not src.exists():
        return None
    THUMBS.mkdir(parents=True, exist_ok=True)
    key = hashlib.md5(f"{src}:{src.stat().st_mtime_ns}:{EXP_W}x{EXP_H}".encode()).hexdigest()
    out = THUMBS / f"{key}.jpg"
    if not out.exists():
        subprocess.run(["magick", str(src), "-resize", f"{EXP_W}x{EXP_H}^", "-gravity", "center",
                        "-extent", f"{EXP_W}x{EXP_H}", "-quality", "90", str(out)], capture_output=True)
    return out if out.exists() else None


def surface_from(path):
    """Decode once into a cairo surface (drawing a pixbuf every frame is slow)."""
    pb = GdkPixbuf.Pixbuf.new_from_file(str(path))
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, pb.get_width(), pb.get_height())
    cr = cairo.Context(surf)
    Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
    cr.paint()
    return surf


def parallelogram(cr, x, y, w, h):
    cr.move_to(x + SKEW, y)
    cr.line_to(x + w, y)
    cr.line_to(x + w - SKEW, y + h)
    cr.line_to(x, y + h)
    cr.close_path()


def ease_out_cubic(t):
    return 1 - (1 - t) ** 3


class Picker(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="rice.themepicker",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.surfaces = {}           # preview path -> cairo surface
        self.themes = []
        self.filter = ""
        self.sel = 0                 # index into self.view()
        self.target = 0.0            # selection as an unbounded position (wraps visually)
        self.pos = 0.0               # animated position, chases target
        self.anim = None             # (from, to, start time)
        self.current = ""
        self.pal = palette()

    # ------------------------------------------------------------ service --
    def do_command_line(self, cl):
        args = cl.get_arguments()[1:]
        if "--service" in args:
            if not getattr(self, "_held", False):
                self._held = True
                self.hold()
                GLib.idle_add(self.warm)
        else:
            self.activate()
        return 0

    def warm(self):
        for t in load_themes():
            self.surface_for(t["wallpaper"])
        return False

    def surface_for(self, wall):
        p = preview_path(wall)
        if p is None:
            return None
        if p not in self.surfaces:
            try:
                self.surfaces[p] = surface_from(p)
            except GLib.Error:
                return None
        return self.surfaces[p]

    def do_activate(self):
        if self.win is not None:         # Super+T again closes it
            self.close()
            return
        self.open()

    # ------------------------------------------------------------- window --
    def open(self):
        self.themes = load_themes()
        self.pal = palette()
        self.current = STATE.read_text().strip() if STATE.exists() else ""
        self.filter = ""
        names = [t["name"] for t in self.themes]
        self.sel = names.index(self.current) if self.current in names else 0
        self.pos = self.target = float(self.sel)
        self.anim = None

        win = Gtk.ApplicationWindow(application=self, title="Theme switcher")
        win.set_decorated(False)
        if not getattr(self, "_css", None):
            self._css = Gtk.CssProvider()
            self._css.load_from_string("window { background: transparent; }")
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self._css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        wayland = "Wayland" in type(Gdk.Display.get_default()).__name__
        if LayerShell and wayland and LayerShell.is_supported():
            LayerShell.init_for_window(win)
            LayerShell.set_namespace(win, "rice-themepicker")
            LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.EXCLUSIVE)
            LayerShell.set_exclusive_zone(win, -1)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM,
                         LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(win, edge, True)
            mon = self.focused_monitor()
            if mon is not None:
                LayerShell.set_monitor(win, mon)
        else:                            # no layer shell: plain fullscreen window
            win.set_default_size(1600, 900)
            win.fullscreen()

        area = Gtk.DrawingArea(hexpand=True, vexpand=True)
        area.set_draw_func(self.draw)
        win.set_child(area)
        self.area = area

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)
        click = Gtk.GestureClick()
        click.connect("pressed", self.on_click)
        area.add_controller(click)
        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL
                                           | Gtk.EventControllerScrollFlags.DISCRETE)
        scroll.connect("scroll", lambda _c, _dx, dy: (self.move(1 if dy > 0 else -1), True)[1])
        area.add_controller(scroll)

        self.win = win
        win.present()

    def focused_monitor(self):
        try:
            mons = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True,
                                             text=True).stdout)
            name = next(m["name"] for m in mons if m.get("focused"))
        except (ValueError, StopIteration):
            return None
        gmons = Gdk.Display.get_default().get_monitors()
        for i in range(gmons.get_n_items()):
            m = gmons.get_item(i)
            if m.get_connector() == name:
                return m
        return None

    def close(self):
        if self.win is not None:
            self.win.destroy()
            self.win = None

    # -------------------------------------------------------------- model --
    def view(self):
        """Themes matching the filter (name or label contains it)."""
        if not self.filter:
            return self.themes
        q = self.filter.lower()
        return [t for t in self.themes if q in t["name"] or q in t["label"]]

    def ring(self, x):
        """Signed distance on the carousel ring: the list wraps around, so
        both sides of the selection are always filled."""
        n = len(self.view())
        if n <= 1:
            return x
        return ((x + n / 2) % n) - n / 2

    def move(self, d):
        if self.view():
            self.go_to(self.target + d)

    def select(self, i):
        """Select item i the short way round the ring."""
        self.go_to(self.target + self.ring(i - self.target))

    def go_to(self, target):
        n = len(self.view())
        if target == self.target or not n:
            return
        self.target = target
        self.sel = int(round(target)) % n
        self.anim = (self.pos, target, time.monotonic())
        self.area.add_tick_callback(self.tick)

    def tick(self, _widget, _clock):
        if not self.anim:
            return False
        a, b, t0 = self.anim
        t = min(1.0, (time.monotonic() - t0) * 1000 / SLIDE_MS)
        self.pos = a + (b - a) * ease_out_cubic(t)
        self.area.queue_draw()
        if t >= 1.0:
            self.anim = None
            return False
        return True

    def set_filter(self, text):
        chosen = self.view()[self.sel]["name"] if self.view() else None
        self.filter = text
        v = self.view()
        names = [t["name"] for t in v]
        self.sel = names.index(chosen) if chosen in names else 0
        self.pos = self.target = float(self.sel)
        self.anim = None
        self.area.queue_draw()

    def apply_selected(self):
        v = self.view()
        if v:
            apply_theme(v[self.sel]["name"])
        self.close()

    # ------------------------------------------------------------- input --
    def on_key(self, _c, keyval, _code, state):
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        if keyval == Gdk.KEY_Escape:
            self.set_filter("") if self.filter else self.close()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.apply_selected()
        elif keyval in (Gdk.KEY_Left, Gdk.KEY_ISO_Left_Tab) or (keyval == Gdk.KEY_Tab and state & Gdk.ModifierType.SHIFT_MASK):
            self.move(-1)
        elif keyval in (Gdk.KEY_Right, Gdk.KEY_Tab):
            self.move(1)
        elif keyval == Gdk.KEY_Home:
            self.select(0)
        elif keyval == Gdk.KEY_End:
            self.select(max(0, len(self.view()) - 1))
        elif keyval == Gdk.KEY_BackSpace:
            self.set_filter(self.filter[:-1])
        elif not ctrl:
            ch = chr(Gdk.keyval_to_unicode(keyval)) if Gdk.keyval_to_unicode(keyval) else ""
            if ch.isprintable() and ch:
                self.set_filter(self.filter + ch.lower())
        return True

    def on_click(self, gesture, _n, x, y):
        hit = self.hit(x, y)
        if hit is None:
            # outside every card: close (unless inside the card band itself)
            w, h = self.area.get_width(), self.area.get_height()
            top = self.card_top(h)
            if not (top - 20 <= y <= top + EXP_H + 140 and abs(x - w / 2) <= EXP_W / 2 + 40):
                self.close()
        elif hit == self.sel:
            self.apply_selected()
        else:
            self.select(hit)

    # ------------------------------------------------------------ drawing --
    def card_top(self, h):
        return (h - (EXP_H + 120)) / 2

    def geometry(self, i, w, h):
        """Rect of card i given the animated selection position."""
        r = self.ring(i - self.pos)
        x0 = (w - EXP_W) / 2
        top = self.card_top(h)
        if r <= 0:
            x = x0 + r * STEP
        elif r < 1:
            x = x0 + r * (EXP_W + SPACING)
        else:
            x = x0 + EXP_W + SPACING + (r - 1) * STEP
        k = min(1.0, abs(r))              # 0 = selected, 1 = slice
        cw = EXP_W + (SLICE_W - EXP_W) * k
        ch = EXP_H + (SLICE_H - EXP_H) * k
        cy = top + (EXP_H - ch) / 2
        return x, cy, cw, ch, k

    def hit(self, px, py):
        w, h = self.area.get_width(), self.area.get_height()
        v = self.view()
        order = sorted(range(len(v)), key=lambda i: -abs(self.ring(i - self.pos)))   # topmost last
        for i in reversed(order):
            x, y, cw, ch, _ = self.geometry(i, w, h)
            if y <= py <= y + ch:
                # inside the slanted shape at this height?
                off = SKEW * (1 - (py - y) / ch)
                if x + off <= px <= x + cw - SKEW + off:
                    return i
        return None

    def draw(self, _area, cr, w, h):
        pal = self.pal
        bg, fg, accent = rgb(pal["bg"]), rgb(pal["fg"]), rgb(pal["accent"])
        # scrim
        cr.set_source_rgba(*bg, 0.72)
        cr.paint()

        v = self.view()
        if not v:
            self.text(cr, w / 2, h / 2, f"no theme matches “{self.filter}”", 22, fg, bold=True)
            return

        # far cards first, the selected one on top
        for i in sorted(range(len(v)), key=lambda i: -abs(self.ring(i - self.pos))):
            x, y, cw, ch, k = self.geometry(i, w, h)
            if x > w or x + cw < 0:
                continue
            t = v[i]
            parallelogram(cr, x, y, cw, ch)
            cr.save()
            cr.clip()
            surf = self.surface_for(t["wallpaper"])
            if surf is not None:
                sw, sh = surf.get_width(), surf.get_height()
                scale = max(cw / sw, ch / sh)
                cr.translate(x + (cw - sw * scale) / 2, y + (ch - sh * scale) / 2)
                cr.scale(scale, scale)
                cr.set_source_surface(surf, 0, 0)
                cr.get_source().set_filter(cairo.FILTER_GOOD)
                cr.paint()
            else:
                cr.set_source_rgb(*bg)
                cr.paint()
            cr.restore()
            if t["name"] in (AUTO, RANDOM):             # mark the two extra cards
                cr.save()
                parallelogram(cr, x, y, cw, ch)
                cr.clip()
                cr.set_source_rgba(*bg, 0.55)
                cr.paint()
                glyph = "\U000f0e09" if t["name"] == AUTO else "\U000f076e"   # eyedropper / dice
                self.text(cr, x + cw / 2, y + ch / 2 - 18, glyph, 64 - 36 * k, fg)
                cr.restore()
            # dim the unselected (42% like Omarchy), fading with distance
            if k > 0:
                parallelogram(cr, x, y, cw, ch)
                cr.set_source_rgba(*bg, 0.42 * k)
                cr.fill()
            # border: accent on the selected, faint on the rest
            parallelogram(cr, x, y, cw, ch)
            if k < 0.5:
                cr.set_source_rgba(*accent, 1)
                cr.set_line_width(3)
            else:
                cr.set_source_rgba(*fg, 0.22)
                cr.set_line_width(1)
            cr.stroke()

        # label under the carousel
        t = v[self.sel]
        top = self.card_top(h)
        self.text(cr, w / 2, top + EXP_H + 38, t["label"], 30, fg, bold=True, outline=bg)
        sub = t["kind"] + ("  ·  light" if t["light"] else "") + ("  ·  active" if t["name"] == self.current else "")
        self.text(cr, w / 2, top + EXP_H + 74, sub, 14, fg, alpha=0.7, outline=bg)
        if self.filter:
            self.text(cr, w / 2, top + EXP_H + 104, "\U000f0349  " + self.filter, 16, accent, outline=bg)
        else:
            self.text(cr, w / 2, h - 46, "←  →  choose      enter  apply      type to filter      esc  close",
                      12, fg, alpha=0.45)

    def text(self, cr, cx, cy, s, size, color, bold=False, alpha=1.0, outline=None):
        layout = PangoCairo.create_layout(cr)
        desc = Pango.FontDescription.from_string(f"{FONT} {'Bold ' if bold else ''}{size:.0f}px")
        desc.set_absolute_size(size * Pango.SCALE)
        layout.set_font_description(desc)
        layout.set_text(s, -1)
        tw, th = layout.get_pixel_size()
        cr.move_to(cx - tw / 2, cy - th / 2)
        if outline is not None:                        # soft outline, like Omarchy's label
            PangoCairo.layout_path(cr, layout)
            cr.set_source_rgba(*outline, 0.7)
            cr.set_line_width(4)
            cr.stroke()
            cr.move_to(cx - tw / 2, cy - th / 2)
        cr.set_source_rgba(*color, alpha)
        PangoCairo.show_layout(cr, layout)


if __name__ == "__main__":
    Picker().run(sys.argv)
