#!/bin/bash
# Video wallpapers, played by mpvpaper on the "bottom" layer: above the still
# wallpaper (Omarchy's or awww's), below windows and the bar, and
# click-through, so desktop clicks still reach what's under it.
#
# Videos live in ~/Pictures/wallpapers/live/<theme>/ (mp4, webm, mkv, mov),
# each with a poster (its first frame, <name>.jpg) generated next to it. On
# Omarchy the posters are copied into ~/.config/omarchy/backgrounds/<theme>/,
# so Omarchy's own background switcher lists the videos, and `watch` plays
# whichever one is selected. (Real copies, not symlinks: Omarchy matches the
# current background by resolved path.) On the full install the theme's
# videos play in turn.
#
# Usage: live-wallpaper [<theme>]   play the theme's video (default: active theme)
#        live-wallpaper next|prev   switch to the theme's next/previous video
#        live-wallpaper off|on      disable/enable video wallpapers (remembered)
#        live-wallpaper toggle
#        live-wallpaper stop        stop playback for now
#        live-wallpaper sync        Omarchy: play the video behind the current background
#        live-wallpaper watch       Omarchy: keep syncing as the background changes
#        live-wallpaper fetch [<theme>...]  download videos from manifest.txt
#        live-wallpaper posters     (re)generate missing posters

LIVE="$HOME/Pictures/wallpapers/live"
MANIFEST="$LIVE/manifest.txt"
STATE="$HOME/.local/state/hypr-rice"
CURRENT="$STATE/live-current"      # video currently playing
DISABLED="$STATE/live-disabled"
OMARCHY_BG="$HOME/.local/state/omarchy/current/background"
OMARCHY_BACKGROUNDS="$HOME/.config/omarchy/backgrounds"
VIDEO_EXT=(mp4 webm mkv mov)
mkdir -p "$STATE"

omarchy_mode() { command -v omarchy >/dev/null && [[ -d $HOME/.local/state/omarchy/current ]]; }

active_theme() {
  if [[ -n $HYPR_RICE_THEME_FILE ]]; then
    cat "$HYPR_RICE_THEME_FILE"
  elif omarchy_mode; then
    cat "$HOME/.local/state/omarchy/current/theme.name"
  else
    cat "$HOME/.config/aether/current-theme" 2>/dev/null
  fi
}

locked() { # run a command under the playback lock
  (
    flock 9
    "$@"
  ) 9>"${XDG_RUNTIME_DIR:-/tmp}/hypr-rice-live.lock"
}

stop() {
  pkill -x mpvpaper
  for _ in {1..20}; do pgrep -x mpvpaper >/dev/null || break; sleep 0.1; done
  rm -f "$CURRENT"
}

play() { # play <video>
  # Same video already up (e.g. a re-apply of the same theme): leave it be
  [[ $(cat "$CURRENT" 2>/dev/null) == "$1" ]] && pgrep -x mpvpaper >/dev/null && return
  stop
  mpvpaper -f -l bottom -p -o "no-audio loop panscan=1.0 hwdec=auto" '*' "$1" >/dev/null 2>&1 9>&-
  printf '%s\n' "$1" > "$CURRENT"
}

videos() { # videos <theme> -> sorted list
  local args=() e
  for e in "${VIDEO_EXT[@]}"; do args+=(-o -iname "*.$e"); done
  find -L "$LIVE/$1" -maxdepth 1 -type f \( "${args[@]:1}" \) 2>/dev/null | sort
}

video_for() { # video_for <image> -> the video that image is the poster of
  local e stem=${1##*/}; stem=${stem%.*}
  for e in "${VIDEO_EXT[@]}"; do
    [[ -f ${1%.*}.$e ]] && { printf '%s\n' "${1%.*}.$e"; return; }
    [[ -f $LIVE/$(active_theme)/$stem.$e ]] && { printf '%s\n' "$LIVE/$(active_theme)/$stem.$e"; return; }
  done
  return 1
}

posters() { # posters [<theme>...]: first frame of each video as <name>.jpg
  local t v p themes=("$@")
  ((${#themes[@]})) || for t in "$LIVE"/*/; do themes+=("$(basename "$t")"); done
  for t in "${themes[@]}"; do
    while read -r v; do
      p="${v%.*}.jpg"
      [[ -s $p && $p -nt $v ]] || ffmpeg -loglevel error -y -i "$v" -frames:v 1 -q:v 2 "$p" </dev/null || rm -f "$p"
    done < <(videos "$t")
    if omarchy_mode; then publish "$t"; fi
  done
  return 0
}

publish() { # Omarchy: offer <theme>'s posters as its backgrounds
  local t=$1 v p first="" dest="$OMARCHY_BACKGROUNDS/$1" theme_dir="$HOME/.config/omarchy/themes/$1"
  [[ -n $(videos "$t") ]] || return 0
  [[ -L $dest ]] && rm "$dest"     # older installs linked the folder
  mkdir -p "$dest"
  while read -r v; do
    p="${v%.*}.jpg"
    [[ -s $p ]] || continue
    cp -u "$p" "$dest/"
    [[ -n $first ]] || first=$p
  done < <(videos "$t")

  # A rice theme shows only its videos: drop the still-collection link and
  # give the theme menu a preview from the first video.
  if grep -qs "generated from config/aether/blueprints" "$theme_dir/colors.toml"; then
    [[ -L $theme_dir/backgrounds ]] && rm "$theme_dir/backgrounds"
    [[ -n $first ]] && cp "$first" "$theme_dir/preview.jpg"
  fi
  return 0
}

start() { # start <theme> [next|prev]
  [[ -f $DISABLED ]] && { stop; return; }
  mapfile -t vids < <(videos "$1")
  (( ${#vids[@]} )) || { stop; return; }

  local cur idx=-1 i n=${#vids[@]}
  # Omarchy's background is the source of truth there; elsewhere what's playing
  omarchy_mode && cur=$(video_for "$(readlink -f "$OMARCHY_BG")")
  [[ -n $cur ]] || cur=$(cat "$CURRENT" 2>/dev/null)
  for i in "${!vids[@]}"; do [[ ${vids[$i]} == "$cur" ]] && idx=$i && break; done

  case $2 in
    next) idx=$(( (idx + 1) % n )) ;;
    prev) idx=$(( idx < 0 ? n - 1 : (idx - 1 + n) % n )) ;;
    *)    (( idx < 0 )) && idx=0 ;;
  esac

  # On Omarchy, switch the background too, so the still layer, the
  # background switcher and the video all agree.
  if omarchy_mode && [[ -n $2 ]]; then
    local name=${vids[$idx]##*/} bg
    bg="$OMARCHY_BACKGROUNDS/$1/${name%.*}.jpg"
    [[ -s $bg ]] || posters "$1"
    [[ -s $bg ]] && omarchy-theme-bg-set "$bg" >/dev/null 2>&1
  fi
  play "${vids[$idx]}"
}

sync() { # Omarchy: play the video whose poster is the current background
  [[ -f $DISABLED ]] && { stop; return; }
  local v
  if v=$(video_for "$(readlink -f "$OMARCHY_BG")"); then play "$v"; else stop; fi
}

watch() {
  # One watcher per session
  exec 8>"${XDG_RUNTIME_DIR:-/tmp}/hypr-rice-live-watch.lock"
  flock -n 8 || exit 0
  locked sync
  inotifywait -mq -e create -e moved_to -e attrib --format '%f' "$(dirname "$OMARCHY_BG")" |
    while read -r f; do
      [[ $f == background ]] && locked sync
    done
}

fetch() { # fetch [<theme>...]
  [[ -f $MANIFEST ]] || { echo "No manifest at $MANIFEST" >&2; return 1; }
  local theme name url f fails=0
  while read -r theme name url; do
    [[ -z $theme || $theme == \#* ]] && continue
    (($#)) && [[ " $* " != *" $theme "* ]] && continue
    f="$LIVE/$theme/$name.mp4"
    [[ -s $f ]] && continue
    mkdir -p "$LIVE/$theme"
    printf '  %s/%s\n' "$theme" "$name"
    if curl -fsSL --retry 3 -A 'Mozilla/5.0' -o "$f.part" "$url" \
       && [[ $(file -b --mime-type "$f.part") == video/* ]]; then
      mv "$f.part" "$f"
    else
      rm -f "$f.part"; fails=$((fails + 1)); echo "  failed: $url" >&2
    fi
  done < "$MANIFEST"
  posters "$@"
  return $(( fails > 0 ))
}

case ${1:-} in
  next|prev) locked start "$(active_theme)" "$1" ;;
  off)       touch "$DISABLED"; locked stop ;;
  on)        rm -f "$DISABLED"; if omarchy_mode; then locked sync; else locked start "$(active_theme)"; fi ;;
  toggle)    if [[ -f $DISABLED ]]; then "$0" on; else "$0" off; fi ;;
  stop)      locked stop ;;
  sync)      locked sync ;;
  watch)     watch ;;
  fetch)     shift; fetch "$@" ;;
  posters)   shift; posters "$@" ;;
  "")        if omarchy_mode; then locked sync; else locked start "$(active_theme)"; fi ;;
  *)         locked start "$1" ;;
esac
