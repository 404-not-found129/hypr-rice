#!/usr/bin/env python3
"""hypr-rice settings (Super+,).

One libadwaita window for everything the rice lets you tune, without
editing files by hand:

  Appearance   theme, random / from-wallpaper, wallpaper cycling, live wallpaper
  Look & feel  gaps, borders, rounding, blur, animations, opacity
               -> ~/.config/hypr-rice/look.lua (read by hyprland.lua)
  Schedule     day/night themes and times -> ~/.config/hypr-rice/schedule
  Night light  on/off and temperature     -> ~/.config/hypr-rice/nightlight
  Keybinds     change / turn off any shortcut, add app shortcuts
               -> ~/.config/hypr-rice/binds.json (+ generated binds.lua)
  About        versions, active theme, config folders

Every action goes through the same scripts the keybinds use (themectl,
wallcycle, theme-schedule, nightlight), so behavior never diverges. The
accent color follows the active theme.
"""
import json
import re
import subprocess
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

HOME = Path.home()
BIN = HOME / ".local/bin"
RICE = HOME / ".config/hypr-rice"
LOOK = RICE / "look.lua"
SCHEDULE = RICE / "schedule"
NIGHTLIGHT = RICE / "nightlight"
COLORS = HOME / ".config/aether/theme/colors.toml"
STATE = HOME / ".config/aether/current-theme"

# Must match the defaults in hyprland.lua
LOOK_DEFAULTS = {
    "gaps_in": 5, "gaps_out": 12, "border_size": 2, "rounding": 12,
    "blur": True, "animations": True,
    "inactive_opacity": 0.95, "terminal_opacity": 0.72,
    "shadows": True, "workspaces_per_monitor": 3,
    "follow_mouse": True, "sensitivity": 0.0,
    "square_corners": False, "bar_position": "top",
}
BINDS_JSON = RICE / "binds.json"     # source of truth for the Keybinds page
BINDS_LUA = RICE / "binds.lua"       # generated from it; read by hyprland.lua
WAYBAR_CFG = HOME / ".config/waybar/config.jsonc"
WAYBAR_CSS = HOME / ".config/waybar/style.css"
CSS_BEGIN, CSS_END = "/* rice-settings:begin */", "/* rice-settings:end */"
SCHEDULE_DEFAULTS = {"day": "catppuccin-latte", "night": "rose-pine",
                     "sunrise": "07:00", "sunset": "19:00"}
TIME_RE = re.compile(r"^([01]\d|2[0-3]):[0-5]\d$")


def run(*args, background=False):
    """Run one of the rice's scripts. Background runs never block the UI
    (theme applies take a few seconds)."""
    cmd = [str(BIN / args[0]), *args[1:]] if (BIN / args[0]).exists() else list(args)
    if background:
        subprocess.Popen(["setsid", *cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return ""
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()


def palette():
    cols = {}
    if COLORS.exists():
        cols = dict(re.findall(r'^(\w+)\s*=\s*"([^"]*)"', COLORS.read_text(), re.M))
    return cols


def is_light(hexcol):
    """Same luminance test color-scheme-sync uses."""
    h = hexcol.lstrip("#")
    if not re.fullmatch(r"[0-9a-fA-F]{6}", h):
        return False
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.5


def themes():
    out = run("themectl", "list")
    return [line[2:].strip() for line in out.splitlines() if line.strip()]


def current_theme():
    return STATE.read_text().strip() if STATE.exists() else ""


def read_kv(path, defaults):
    vals = dict(defaults)
    if path.exists():
        for line in path.read_text().splitlines():
            m = re.match(r"^\s*(\w+)\s*=\s*(.*?)\s*,?\s*$", line)
            if m and m.group(1) in vals:
                vals[m.group(1)] = m.group(2).strip('"')
    return vals


def read_look():
    raw = read_kv(LOOK, {k: str(v) for k, v in LOOK_DEFAULTS.items()})
    look = {}
    for k, default in LOOK_DEFAULTS.items():
        v = raw[k]
        if isinstance(default, bool):
            look[k] = v.lower() == "true" if isinstance(v, str) else bool(v)
        elif isinstance(default, str):
            look[k] = v
        elif isinstance(default, float):
            look[k] = float(v)
        else:
            look[k] = int(float(v))
    return look


def write_look(look):
    RICE.mkdir(parents=True, exist_ok=True)
    body = []
    for k in LOOK_DEFAULTS:
        v = look[k]
        if isinstance(v, bool):
            v = "true" if v else "false"
        elif isinstance(v, str):
            v = lua_str(v)
        elif isinstance(v, float):
            v = f"{v:.2f}"
        body.append(f"    {k} = {v},")
    LOOK.write_text("-- Written by rice-settings; read by ~/.config/hypr/hyprland.lua\nreturn {\n"
                    + "\n".join(body) + "\n}\n")


def lua_str(v):
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"').replace("\n", " ") + '"'


def apply_bar(look):
    """Bar position and square corners live in waybar's own files: patch the
    config's position and a marked block at the end of style.css, then have
    waybar reload them."""
    if WAYBAR_CFG.exists():
        try:
            cfg = json.loads(WAYBAR_CFG.read_text())
            pos = look["bar_position"] if look["bar_position"] in ("top", "bottom") else "top"
            margin = max(cfg.get("margin-top", 0), cfg.get("margin-bottom", 0), 6)
            cfg["position"] = pos
            cfg.pop("margin-top", None)
            cfg.pop("margin-bottom", None)
            cfg["margin-top" if pos == "top" else "margin-bottom"] = margin
            WAYBAR_CFG.write_text(json.dumps(cfg, indent=4, ensure_ascii=False) + "\n")
        except (ValueError, OSError):
            pass
    if WAYBAR_CSS.exists():
        css = WAYBAR_CSS.read_text()
        css = re.sub(re.escape(CSS_BEGIN) + r".*?" + re.escape(CSS_END) + r"\n?", "", css, flags=re.S)
        if look["square_corners"]:
            # selectors outrank the theme's own (id + class beats class alone)
            css = css.rstrip() + (f"\n\n{CSS_BEGIN}\n"
                                  "window#waybar, window#waybar *, window#waybar .modules-left,\n"
                                  "window#waybar .modules-center, window#waybar .modules-right,\n"
                                  "window#waybar #workspaces button, tooltip { border-radius: 0; }\n"
                                  f"{CSS_END}\n")
        WAYBAR_CSS.write_text(css)
    subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"], capture_output=True)


def read_binds():
    try:
        d = json.loads(BINDS_JSON.read_text())
    except (OSError, ValueError):
        d = {}
    return {"keys": d.get("keys", {}), "disabled": d.get("disabled", []), "apps": d.get("apps", [])}


def write_binds(b):
    RICE.mkdir(parents=True, exist_ok=True)
    BINDS_JSON.write_text(json.dumps(b, indent=2) + "\n")
    out = ["-- Written by rice-settings from binds.json (edit that, or use the app).",
           "-- Read by ~/.config/hypr/hyprland.lua.", "return {", "    keys = {"]
    out += [f"        [{lua_str(d)}] = {lua_str(k)}," for d, k in sorted(b["keys"].items())]
    out += ["    },", "    disabled = {"]
    out += [f"        [{lua_str(d)}] = true," for d in sorted(b["disabled"])]
    out += ["    },", "    apps = {"]
    out += [f"        {{ keys = {lua_str(a['keys'])}, name = {lua_str(a['name'])}, cmd = {lua_str(a['cmd'])} }},"
            for a in b["apps"]]
    out += ["    },", "}", ""]
    BINDS_LUA.write_text("\n".join(out))


def live_binds():
    try:
        return json.loads(run("keybinds", "--json") or "[]")
    except ValueError:
        return []


MOD_NAMES = {"Shift_L", "Shift_R", "Control_L", "Control_R", "Alt_L", "Alt_R", "Super_L",
             "Super_R", "Meta_L", "Meta_R", "Hyper_L", "Hyper_R", "ISO_Level3_Shift", "Caps_Lock"}
# what Shift+key produces (US layout) -> the key Hyprland binds on
UNSHIFT = {"exclam": "1", "at": "2", "numbersign": "3", "dollar": "4", "percent": "5",
           "asciicircum": "6", "ampersand": "7", "asterisk": "8", "parenleft": "9",
           "parenright": "0", "underscore": "minus", "plus": "equal", "question": "slash",
           "less": "comma", "greater": "period", "colon": "semicolon", "quotedbl": "apostrophe",
           "braceleft": "bracketleft", "braceright": "bracketright", "bar": "backslash",
           "asciitilde": "grave"}
LONE_OK = re.compile(r"^(F\d+|Print|XF86\w+|Pause|Scroll_Lock|Insert)$")


class KeyCapture(Adw.Dialog):
    """Press-a-shortcut dialog. While open, Hyprland sits in the empty
    `rice_capture` submap so the keys reach this window instead of firing
    their current binds."""

    def __init__(self, title, taken, on_done):
        super().__init__(title=title, content_width=440)
        self.taken, self.on_done, self.combo = taken, on_done, None
        tv = Adw.ToolbarView()
        hb = Adw.HeaderBar(show_end_title_buttons=False, show_start_title_buttons=False)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        self.save = Gtk.Button(label="Set", sensitive=False)
        self.save.add_css_class("suggested-action")
        self.save.connect("clicked", self.on_save)
        hb.pack_start(cancel)
        hb.pack_end(self.save)
        tv.add_top_bar(hb)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                      margin_top=24, margin_bottom=28, margin_start=24, margin_end=24)
        hint = Gtk.Label(label="Press the new shortcut")
        hint.add_css_class("dim-label")
        self.shown = Gtk.Label(label="…")
        self.shown.add_css_class("title-1")
        self.msg = Gtk.Label(label="Use at least one of Super, Ctrl, Alt or Shift.", wrap=True)
        self.msg.add_css_class("dim-label")
        for w in (hint, self.shown, self.msg):
            box.append(w)
        tv.set_content(box)
        self.set_child(tv)
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("closed", lambda *_: subprocess.run(
            ["hyprctl", "dispatch", 'hl.dsp.submap("reset")'], capture_output=True))
        subprocess.run(["hyprctl", "dispatch", 'hl.dsp.submap("rice_capture")'], capture_output=True)
        # safety net: never leave Hyprland in the empty submap for long
        GLib.timeout_add_seconds(30, lambda: self.close() or False)

    def on_key(self, ctrl, keyval, keycode, state):
        name = Gdk.keyval_name(keyval) or ""
        if name in MOD_NAMES:
            return True
        mods = []
        if state & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.META_MASK):
            mods.append("SUPER")
        if state & Gdk.ModifierType.CONTROL_MASK:
            mods.append("CTRL")
        if state & Gdk.ModifierType.ALT_MASK:
            mods.append("ALT")
        if state & Gdk.ModifierType.SHIFT_MASK:
            mods.append("SHIFT")
        if name == "Escape" and not mods:
            self.close()
            return True
        # name the key as it is unshifted (SHIFT + 1, not "exclam")
        name = Gdk.keyval_name(Gdk.keyval_to_lower(keyval)) or name
        name = UNSHIFT.get(name, name)
        if len(name) == 1:
            name = name.upper()
        combo = " + ".join(mods + [name])
        self.shown.set_label(combo)
        if not mods and not LONE_OK.match(name):
            self.msg.set_label("Use at least one of Super, Ctrl, Alt or Shift.")
            self.save.set_sensitive(False)
        elif combo in self.taken:
            self.msg.set_label(f"Already used by “{self.taken[combo]}”. Change or disable that one first.")
            self.save.set_sensitive(False)
        else:
            self.msg.set_label("Free. Press Set to use it.")
            self.combo = combo
            self.save.set_sensitive(True)
        return True

    def on_save(self, *_):
        combo = self.combo
        self.close()
        self.on_done(combo)


class AppShortcut(Adw.Dialog):
    """Pick an installed app (or type a command) and a shortcut for it."""

    def __init__(self, taken, on_done):
        super().__init__(title="Add app shortcut", content_width=520)
        self.taken, self.on_done, self.keys = taken, on_done, None
        self.apps = sorted((a for a in Gio.AppInfo.get_all() if a.should_show()),
                           key=lambda a: a.get_display_name().lower())
        tv = Adw.ToolbarView()
        hb = Adw.HeaderBar(show_end_title_buttons=False, show_start_title_buttons=False)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        self.add = Gtk.Button(label="Add", sensitive=False)
        self.add.add_css_class("suggested-action")
        self.add.connect("clicked", self.on_add)
        hb.pack_start(cancel)
        hb.pack_end(self.add)
        tv.add_top_bar(hb)
        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup()
        self.app_row = Adw.ComboRow(title="App", enable_search=True,
                                    model=Gtk.StringList.new([a.get_display_name() for a in self.apps]))
        self.app_row.connect("notify::selected", lambda *_: self.validate())
        grp.add(self.app_row)
        self.cmd_row = Adw.EntryRow(title="…or a custom command (overrides the app)")
        self.cmd_row.connect("changed", lambda *_: self.validate())
        grp.add(self.cmd_row)
        self.key_row = Adw.ActionRow(title="Shortcut", subtitle="not set")
        btn = Gtk.Button(label="Set…", valign=Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_: KeyCapture("Shortcut for the app", self.taken, self.got_keys)
                    .present(self))
        self.key_row.add_suffix(btn)
        grp.add(self.key_row)
        page.add(grp)
        tv.set_content(page)
        self.set_child(tv)

    def got_keys(self, combo):
        self.keys = combo
        self.key_row.set_subtitle(combo)
        self.validate()

    def validate(self):
        self.add.set_sensitive(bool(self.keys) and (bool(self.cmd_row.get_text().strip()) or bool(self.apps)))

    def on_add(self, *_):
        custom = self.cmd_row.get_text().strip()
        if custom:
            name, cmd = custom.split()[0].split("/")[-1], custom
        else:
            app = self.apps[self.app_row.get_selected()]
            name = app.get_display_name()
            cmd = "gtk-launch " + app.get_id().removesuffix(".desktop")
        self.close()
        self.on_done({"keys": self.keys, "name": name, "cmd": cmd})


def write_schedule(s):
    RICE.mkdir(parents=True, exist_ok=True)
    SCHEDULE.write_text(
        "# Day/night theme schedule -- written by rice-settings.\n"
        "# Any theme name from `themectl list` works.\n"
        + "".join(f"{k}={s[k]}\n" for k in ("day", "night", "sunrise", "sunset")))


class Settings(Adw.Application):
    def __init__(self):
        super().__init__(application_id="rice.settings",
                         flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.win = None
        self.stack = None
        self._look_timer = 0
        self._busy = False   # suppress handlers while filling widgets

    # ------------------------------------------------------------ window --
    def do_command_line(self, cl):
        """`rice-settings [page]` opens on that page (appearance, look,
        schedule, nightlight, keybinds, about); a second call just raises
        the running window."""
        args = cl.get_arguments()[1:]
        self.activate()
        if args and self.stack and self.stack.get_child_by_name(args[0]):
            self.stack.set_visible_child_name(args[0])
        return 0

    def do_activate(self):
        if self.win:
            self.win.present()
            return
        self.apply_accent()
        self.win = Adw.ApplicationWindow(application=self, title="Rice Settings")
        self.win.set_default_size(980, 680)

        self.toasts = Adw.ToastOverlay()
        stack = self.stack = Adw.ViewStack()
        self._busy = True   # widgets fire change signals while being filled
        for name, title, icon, page in (
            ("appearance", "Appearance", "preferences-desktop-appearance-symbolic", self.page_appearance()),
            ("look", "Look & Feel", "preferences-desktop-display-symbolic", self.page_look()),
            ("schedule", "Schedule", "alarm-symbolic", self.page_schedule()),
            ("nightlight", "Night Light", "weather-clear-night-symbolic", self.page_nightlight()),
            ("keybinds", "Keybinds", "input-keyboard-symbolic", self.page_keybinds()),
            ("about", "About", "help-about-symbolic", self.page_about()),
        ):
            stack.add_titled_with_icon(page, name, title, icon)
        self._busy = False

        header = Adw.HeaderBar()
        switcher = Adw.ViewSwitcher(stack=stack, policy=Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(switcher)
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        self.toasts.set_child(stack)
        view.set_content(self.toasts)
        self.win.set_content(view)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, *_: kv == Gdk.KEY_Escape and (self.win.close() or True))
        self.win.add_controller(keys)
        self.win.present()

    def apply_accent(self):
        """Tint libadwaita's accent with the active theme's accent; light/dark
        itself already follows the theme via color-scheme-sync."""
        acc = palette().get("accent")
        if not acc:
            return
        css = (f":root {{ --accent-bg-color: {acc}; --accent-color: {acc}; }}\n"
               f"@define-color accent_bg_color {acc};\n@define-color accent_color {acc};\n")
        prov = Gtk.CssProvider()
        prov.load_from_string(css)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=2))

    def button(self, label, cb, suggested=False):
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        if suggested:
            b.add_css_class("suggested-action")
        b.connect("clicked", lambda *_: cb())
        return b

    # -------------------------------------------------------- appearance --
    def page_appearance(self):
        page = Adw.PreferencesPage()

        grp = Adw.PreferencesGroup(title="Theme",
                                   description="Wallpaper, colors, bar, icons, cursor and terminal all follow it.")
        self.theme_names = themes()
        self.theme_row = Adw.ComboRow(title="Active theme",
                                      model=Gtk.StringList.new(self.theme_names))
        cur = current_theme()
        if cur in self.theme_names:
            self.theme_row.set_selected(self.theme_names.index(cur))
        self.theme_row.connect("notify::selected", self.on_theme_selected)
        grp.add(self.theme_row)

        row = Adw.ActionRow(title="Surprise me", subtitle="Any theme, or only one group")
        box = Gtk.Box(spacing=8)
        box.append(self.button("Any", lambda: self.theme_cmd("random", "Random theme")))
        box.append(self.button("Game", lambda: self.theme_cmd("random games", "Random game theme")))
        box.append(self.button("Aesthetic", lambda: self.theme_cmd("random aesthetic", "Random aesthetic theme")))
        row.add_suffix(box)
        grp.add(row)

        row = Adw.ActionRow(title="Match the wallpaper",
                            subtitle="Extract a palette from whatever wallpaper is showing")
        row.add_suffix(self.button("Extract", lambda: self.theme_cmd("auto", "Colors from wallpaper")))
        grp.add(row)

        row = Adw.ActionRow(title="Visual picker", subtitle="Wallpaper cards for every theme (Super+T)")
        row.add_suffix(self.button("Open", lambda: run("theme-picker", background=True)))
        grp.add(row)
        page.add(grp)

        grp = Adw.PreferencesGroup(title="Wallpaper",
                                   description="Cycles within the active theme's collection; colors re-extract each time.")
        row = Adw.ActionRow(title="Change wallpaper")
        box = Gtk.Box(spacing=8)
        box.append(self.button("Previous", lambda: self.wall_cmd("prev")))
        box.append(self.button("Next", lambda: self.wall_cmd("next")))
        box.append(self.button("Random", lambda: self.wall_cmd("random")))
        row.add_suffix(box)
        grp.add(row)
        row = Adw.ActionRow(title="Add your own",
                            subtitle="Drop images or videos (.mp4 .webm .gif) into the theme's folder")
        row.add_suffix(self.button("Open folder", self.open_wall_folder))
        grp.add(row)
        page.add(grp)

        grp = Adw.PreferencesGroup(
            title="Live wallpaper",
            description="The current wallpaper, moving: AI-animated clips where you've made them, "
                        "otherwise a theme-matched particle effect. Pauses behind fullscreen apps.")
        live_on = (RICE / "live").exists() and "enabled=1" in (RICE / "live").read_text()
        self.live_row = Adw.SwitchRow(title="Live wallpaper", subtitle="Super+Alt+W", active=live_on)
        self.live_row.connect("notify::active", lambda r, _p: self._busy or
                              run("livewall", "on" if r.get_active() else "off", background=True))
        grp.add(self.live_row)
        live_conf = (RICE / "live").read_text() if (RICE / "live").exists() else ""
        self.fx_row = Adw.SwitchRow(
            title="Particle effect fallback",
            subtitle="Snow / embers / rain for wallpapers that aren't AI-animated yet",
            active="effects=0" not in live_conf)
        self.fx_row.connect("notify::active", lambda r, _p: self._busy or
                            run("livewall", "effects", "on" if r.get_active() else "off", background=True))
        grp.add(self.fx_row)

        smooth = "fps_cap=0" in live_conf
        self.smooth_row = Adw.SwitchRow(
            title="Smooth 60 fps",
            subtitle="Off: videos play at 30 fps -- about half the CPU/GPU work, same sharpness",
            active=smooth)
        self.smooth_row.connect("notify::active", lambda r, _p: self._busy or
                                run("livewall", "fps", "off" if r.get_active() else "30", background=True))
        grp.add(self.smooth_row)

        ai_dir = HOME / ".local/share/hypr-rice/live-ai"
        n_ai = len(list(ai_dir.glob("*.mp4"))) if ai_dir.is_dir() else 0
        row = Adw.ActionRow(
            title="Animate with Higgsfield AI",
            subtitle=f"Real motion made from each wallpaper ({n_ai} animated so far). "
                     "Uses credits on your Higgsfield account; shows the cost and asks first.")
        box = Gtk.Box(spacing=8)
        box.append(self.button("This theme", lambda: self.ai_terminal([])))
        box.append(self.button("All themes", lambda: self.ai_terminal(["--all"])))
        row.add_suffix(box)
        grp.add(row)

        row = Adw.ActionRow(title="Prepare particle effects",
                            subtitle="Render the fallback effect for every wallpaper of the active theme now")
        row.add_suffix(self.button("Render", lambda: (run("livewall", "prerender", background=True),
                                                      self.toast("Rendering in the background…"))))
        grp.add(row)
        row = Adw.ActionRow(title="Pause / resume playback")
        row.add_suffix(self.button("Pause", lambda: run("livewall", "pause", background=True)))
        grp.add(row)
        page.add(grp)
        return page

    def on_theme_selected(self, row, _pspec):
        if self._busy:
            return
        name = self.theme_names[row.get_selected()]
        if name != current_theme():
            run("themectl", "set", name, background=True)
            self.toast(f"Applying {name}…")

    def theme_cmd(self, args, msg):
        run("themectl", *args.split(), background=True)
        self.toast(f"{msg}…")
        GLib.timeout_add_seconds(3, self.sync_theme_row)

    def sync_theme_row(self):
        cur = current_theme()
        if cur in self.theme_names:
            self._busy = True
            self.theme_row.set_selected(self.theme_names.index(cur))
            self._busy = False
        return False

    def ai_terminal(self, extra):
        """livewall-ai is interactive (cost estimate + confirmation), so it
        runs in a terminal window rather than in the background."""
        cmd = " ".join([str(BIN / "livewall-ai"), *extra])
        subprocess.Popen(["setsid", "alacritty", "--title", "Animate wallpapers", "-e", "bash", "-c",
                          f"{cmd}; echo; read -rp 'Press Enter to close'"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def wall_cmd(self, how):
        run("wallcycle", how, background=True)
        self.toast("Changing wallpaper…")

    def open_wall_folder(self):
        d = HOME / "Pictures/wallpapers/collections" / (current_theme() or "")
        d.mkdir(parents=True, exist_ok=True)
        Gio.AppInfo.launch_default_for_uri(d.as_uri(), None)

    # ------------------------------------------------------- look & feel --
    def page_look(self):
        page = Adw.PreferencesPage()
        look = read_look()
        self.look_rows = {}

        def spin(key, title, subtitle, lo, hi, step, digits=0):
            r = Adw.SpinRow.new_with_range(lo, hi, step)
            r.set_title(title)
            r.set_subtitle(subtitle)
            r.set_digits(digits)
            r.set_value(look[key])
            r.connect("notify::value", lambda *_: self.look_changed())
            self.look_rows[key] = r
            return r

        def switch(key, title, subtitle):
            r = Adw.SwitchRow(title=title, subtitle=subtitle, active=look[key])
            r.connect("notify::active", lambda *_: self.look_changed())
            self.look_rows[key] = r
            return r

        grp = Adw.PreferencesGroup(title="Layout", description="Changes apply live.")
        grp.add(spin("gaps_in", "Inner gaps", "Space between windows", 0, 40, 1))
        grp.add(spin("gaps_out", "Outer gaps", "Space around the screen edge", 0, 80, 1))
        grp.add(spin("border_size", "Border width", "Theme-colored window border", 0, 10, 1))
        sq = switch("square_corners", "Square corners", "No rounding on windows or the bar")
        grp.add(sq)
        rnd = spin("rounding", "Corner rounding", "Window corner radius", 0, 40, 1)
        rnd.set_sensitive(not look["square_corners"])
        sq.connect("notify::active", lambda r, _p: rnd.set_sensitive(not r.get_active()))
        grp.add(rnd)
        page.add(grp)

        grp = Adw.PreferencesGroup(title="Effects")
        grp.add(switch("blur", "Blur", "Frosted glass behind translucent windows, bar and launcher"))
        grp.add(switch("shadows", "Shadows", "Soft shadow under windows"))
        grp.add(switch("animations", "Animations", "Turn off for a snappier, lighter desktop"))
        grp.add(spin("inactive_opacity", "Unfocused window opacity", "1.00 = fully opaque", 0.5, 1.0, 0.05, 2))
        grp.add(spin("terminal_opacity", "Terminal opacity", "Alacritty and kitty", 0.4, 1.0, 0.02, 2))
        page.add(grp)

        grp = Adw.PreferencesGroup(title="Bar")
        pos = Adw.ComboRow(title="Position", subtitle="Where the bar sits on every monitor",
                           model=Gtk.StringList.new(["Top", "Bottom"]))
        pos.set_selected(1 if look["bar_position"] == "bottom" else 0)
        pos.connect("notify::selected", lambda *_: self.look_changed())
        self.look_rows["bar_position"] = pos
        grp.add(pos)
        page.add(grp)

        grp = Adw.PreferencesGroup(title="Desktops &amp; input")
        grp.add(spin("workspaces_per_monitor", "Desktops per monitor",
                     "Super + 1… switches among the focused monitor's own desktops", 1, 6, 1))
        grp.add(switch("follow_mouse", "Focus follows mouse", "Off: click a window to focus it"))
        grp.add(spin("sensitivity", "Mouse sensitivity", "-1.0 slowest · 0 default · 1.0 fastest",
                     -1.0, 1.0, 0.1, 1))
        page.add(grp)

        grp = Adw.PreferencesGroup()
        row = Adw.ActionRow(title="Reset to defaults")
        row.add_suffix(self.button("Reset", self.reset_look))
        grp.add(row)
        page.add(grp)
        return page

    def look_changed(self):
        if self._busy:
            return
        # debounce: spin buttons fire per step while held
        if self._look_timer:
            GLib.source_remove(self._look_timer)
        self._look_timer = GLib.timeout_add(350, self.save_look)

    def collect_look(self):
        look = {}
        for k, default in LOOK_DEFAULTS.items():
            r = self.look_rows[k]
            if k == "bar_position":
                look[k] = "bottom" if r.get_selected() == 1 else "top"
            elif isinstance(default, bool):
                look[k] = r.get_active()
            elif isinstance(default, float):
                look[k] = round(r.get_value(), 2)
            else:
                look[k] = int(r.get_value())
        return look

    def save_look(self):
        self._look_timer = 0
        look = self.collect_look()
        write_look(look)
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        apply_bar(look)
        return False

    def reset_look(self):
        self._busy = True
        for k, v in LOOK_DEFAULTS.items():
            r = self.look_rows[k]
            if k == "bar_position":
                r.set_selected(0)
            elif isinstance(v, bool):
                r.set_active(v)
            else:
                r.set_value(v)
        self._busy = False
        LOOK.unlink(missing_ok=True)
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        apply_bar(dict(LOOK_DEFAULTS))
        self.toast("Look & feel reset")

    # ---------------------------------------------------------- schedule --
    def page_schedule(self):
        page = Adw.PreferencesPage()
        s = read_kv(SCHEDULE, SCHEDULE_DEFAULTS)
        names = self.theme_names or themes()

        grp = Adw.PreferencesGroup(
            title="Day / night themes",
            description="Switches theme at sunrise and sunset. Picking a theme by hand is respected until the next switch.")
        enabled = subprocess.run(["systemctl", "--user", "is-enabled", "theme-schedule.timer"],
                                 capture_output=True, text=True).stdout.strip() == "enabled"
        self.sched_on = Adw.SwitchRow(title="Automatic switching", active=enabled)
        self.sched_on.connect("notify::active", self.on_schedule_toggled)
        grp.add(self.sched_on)

        self.sched_rows = {}
        for key, title in (("day", "Day theme"), ("night", "Night theme")):
            r = Adw.ComboRow(title=title, model=Gtk.StringList.new(names))
            if s[key] in names:
                r.set_selected(names.index(s[key]))
            r.connect("notify::selected", lambda *_: self.save_schedule())
            self.sched_rows[key] = r
            grp.add(r)
        for key, title in (("sunrise", "Day starts at"), ("sunset", "Night starts at")):
            r = Adw.EntryRow(title=f"{title} (HH:MM)", text=s[key], show_apply_button=True)
            r.connect("apply", lambda *_: self.save_schedule())
            self.sched_rows[key] = r
            grp.add(r)
        page.add(grp)
        return page

    def collect_schedule(self):
        names = self.theme_names
        s = {k: names[self.sched_rows[k].get_selected()] for k in ("day", "night")}
        for k in ("sunrise", "sunset"):
            s[k] = self.sched_rows[k].get_text().strip()
        return s

    def save_schedule(self):
        if self._busy:
            return
        s = self.collect_schedule()
        bad = [k for k in ("sunrise", "sunset") if not TIME_RE.match(s[k])]
        for k in ("sunrise", "sunset"):
            (self.sched_rows[k].add_css_class if k in bad else self.sched_rows[k].remove_css_class)("error")
        if bad:
            self.toast("Times must look like 07:30")
            return
        write_schedule(s)
        if self.sched_on.get_active():
            run("theme-schedule", "on", background=True)  # re-evaluate right now
        self.toast("Schedule saved")

    def on_schedule_toggled(self, row, _pspec):
        if self._busy:
            return
        if row.get_active():
            self.save_schedule()
            run("theme-schedule", "on", background=True)
            self.toast("Schedule on")
        else:
            run("theme-schedule", "off", background=True)
            self.toast("Schedule off")

    # -------------------------------------------------------- night light --
    def page_nightlight(self):
        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup(title="Night light",
                                   description="Warmer colors to go easy on your eyes at night (Super+N).")
        running = subprocess.run(["pgrep", "-x", "hyprsunset"], capture_output=True).returncode == 0
        self.nl_on = Adw.SwitchRow(title="Night light", active=running)
        self.nl_on.connect("notify::active", lambda r, _p: self._busy or
                           run("nightlight", "on" if r.get_active() else "off"))
        grp.add(self.nl_on)

        temp = int(read_kv(NIGHTLIGHT, {"temp": "4000"})["temp"] or 4000)
        self.nl_temp = Adw.SpinRow.new_with_range(2500, 6500, 100)
        self.nl_temp.set_title("Temperature")
        self.nl_temp.set_subtitle("Kelvin -- lower is warmer (6500 = neutral)")
        self.nl_temp.set_value(temp)
        self._nl_timer = 0
        self.nl_temp.connect("notify::value", lambda *_: self.nl_changed())
        grp.add(self.nl_temp)
        page.add(grp)
        return page

    def nl_changed(self):
        if self._busy:
            return
        if self._nl_timer:
            GLib.source_remove(self._nl_timer)
        self._nl_timer = GLib.timeout_add(500, self.save_nl)

    def save_nl(self):
        self._nl_timer = 0
        RICE.mkdir(parents=True, exist_ok=True)
        NIGHTLIGHT.write_text(f"temp={int(self.nl_temp.get_value())}\n")
        run("nightlight", "restart")
        return False

    # ----------------------------------------------------------- keybinds --
    def page_keybinds(self):
        page = Adw.PreferencesPage()

        grp = Adw.PreferencesGroup(
            title="App shortcuts",
            description="Open any app with a key combination.")
        self.apps_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.apps_list.add_css_class("boxed-list")
        grp.add(self.apps_list)
        add = Gtk.Button(label="Add app shortcut", margin_top=10, halign=Gtk.Align.START)
        add.add_css_class("suggested-action")
        add.connect("clicked", lambda *_: AppShortcut(self.taken(), self.add_app).present(self.win))
        grp.add(add)
        page.add(grp)

        grp = Adw.PreferencesGroup(
            title="All shortcuts",
            description="Change keys or turn shortcuts off. Changes apply immediately; "
                        "Reset restores the original keys.")
        self.kb_search = Gtk.SearchEntry(placeholder_text="Search shortcuts…", margin_bottom=10)
        self.kb_search.connect("search-changed", lambda *_: self.filter_binds())
        grp.add(self.kb_search)
        self.binds_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.binds_list.add_css_class("boxed-list")
        grp.add(self.binds_list)
        page.add(grp)

        self.kb_rows = []
        self.refresh_binds()
        return page

    def taken(self, except_desc=None):
        """keys -> description of every live bind (for conflict checks)."""
        return {b["keys"]: b["description"] for b in live_binds() if b["description"] != except_desc}

    def refresh_binds(self):
        user = read_binds()
        live = live_binds()
        # apps
        self.apps_list.remove_all()
        if not user["apps"]:
            r = Adw.ActionRow(title="No app shortcuts yet")
            r.add_css_class("dim-label")
            self.apps_list.append(r)
        for i, app in enumerate(user["apps"]):
            r = Adw.ActionRow(title=GLib.markup_escape_text(app["name"]),
                              subtitle=GLib.markup_escape_text(f'{app["keys"]}   ·   {app["cmd"]}'))
            rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Remove")
            rm.add_css_class("flat")
            rm.connect("clicked", lambda *_, i=i: self.remove_app(i))
            r.add_suffix(rm)
            self.apps_list.append(r)
        # every other bind, plus the ones turned off (not in Hyprland any more)
        self.binds_list.remove_all()
        self.kb_rows = []
        rows = [b for b in live if not b["description"].startswith("app: ")]
        rows += [{"keys": "", "description": d} for d in user["disabled"]]
        for b in rows:
            desc, keys = b["description"], b["keys"]
            off = desc in user["disabled"]
            changed = desc in user["keys"]
            sub = "off" if off else keys + ("   ·   changed" if changed else "")
            r = Adw.ActionRow(title=GLib.markup_escape_text(desc), subtitle=GLib.markup_escape_text(sub))
            if changed or off:
                reset = Gtk.Button(label="Reset", valign=Gtk.Align.CENTER)
                reset.add_css_class("flat")
                reset.connect("clicked", lambda *_, d=desc: self.reset_bind(d))
                r.add_suffix(reset)
            if not off and "mouse" not in keys:
                ch = Gtk.Button(label="Change", valign=Gtk.Align.CENTER)
                ch.connect("clicked", lambda *_, d=desc: KeyCapture(
                    f"New keys for “{d}”", self.taken(d), lambda c, d=d: self.set_bind(d, c)).present(self.win))
                r.add_suffix(ch)
            sw = Gtk.Switch(active=not off, valign=Gtk.Align.CENTER, tooltip_text="On / off")
            sw.connect("notify::active", lambda w, _p, d=desc: self.toggle_bind(d, w.get_active()))
            r.add_suffix(sw)
            self.binds_list.append(r)
            self.kb_rows.append((r, f"{keys} {desc}".lower()))
        self.filter_binds()

    def filter_binds(self):
        q = self.kb_search.get_text().lower()
        for row, text in self.kb_rows:
            row.set_visible(q in text)

    def save_binds(self, user, msg):
        write_binds(user)
        subprocess.run(["hyprctl", "reload"], capture_output=True)
        GLib.idle_add(lambda: self.refresh_binds() or False)
        self.toast(msg)

    def set_bind(self, desc, combo):
        user = read_binds()
        user["keys"][desc] = combo
        self.save_binds(user, f"{desc}: {combo}")

    def toggle_bind(self, desc, on):
        user = read_binds()
        if on:
            user["disabled"] = [d for d in user["disabled"] if d != desc]
        elif desc not in user["disabled"]:
            user["disabled"].append(desc)
        self.save_binds(user, f"{desc}: {'on' if on else 'off'}")

    def reset_bind(self, desc):
        user = read_binds()
        user["keys"].pop(desc, None)
        user["disabled"] = [d for d in user["disabled"] if d != desc]
        self.save_binds(user, f"{desc}: reset")

    def add_app(self, app):
        user = read_binds()
        user["apps"].append(app)
        self.save_binds(user, f"{app['name']}: {app['keys']}")

    def remove_app(self, i):
        user = read_binds()
        app = user["apps"].pop(i)
        self.save_binds(user, f"Removed {app['name']}")

    # -------------------------------------------------------------- about --
    def page_about(self):
        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup(title="This desktop")

        def info(title, value):
            r = Adw.ActionRow(title=title, subtitle=value or "unknown")
            r.add_css_class("property")
            grp.add(r)

        hypr = subprocess.run(["hyprctl", "version"], capture_output=True, text=True).stdout
        m = re.search(r"Hyprland ([\d.]+)", hypr)
        info("Hyprland", m.group(1) if m else "")
        info("Aether", run("aether", "--version").replace("aether ", ""))
        info("Active theme", current_theme() or "auto")
        info("Mode", "light" if is_light(palette().get("background", "#000000")) else "dark")
        page.add(grp)

        grp2 = Adw.PreferencesGroup(title="Folders")
        for title, path in (("Rice settings", RICE), ("Hyprland config", HOME / ".config/hypr"),
                            ("Theme blueprints", HOME / ".config/aether/blueprints"),
                            ("Wallpapers", HOME / "Pictures/wallpapers/collections")):
            r = Adw.ActionRow(title=title, subtitle=str(path).replace(str(HOME), "~"))
            r.add_suffix(self.button("Open", lambda p=path: Gio.AppInfo.launch_default_for_uri(p.as_uri(), None)))
            grp2.add(r)
        page.add(grp2)
        return page


if __name__ == "__main__":
    import sys
    Settings().run(sys.argv)
