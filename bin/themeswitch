#!/bin/bash
# Theme switcher (walker dmenu fallback for the GTK picker): pick an Aether
# blueprint, a random one, or re-extract from the current wallpaper. Applying
# goes through themectl so everything follows (wallpaper, borders, terminal,
# waybar, hyprlock) under the shared apply lock.

themectl="$HOME/.local/bin/themectl"

# Game themes get a controller, aesthetic themes a palette.
icon_for() {
    case "$("$themectl" category "$1")" in
        games) echo "󰊴" ;;
        *)     echo "󰏘" ;;
    esac
}

menu="󰋩  auto (from current wallpaper)
󰝮  random"
while IFS= read -r name; do
    [ -z "$name" ] && continue
    menu="$menu
$(icon_for "$name")  $name"
done < <(aether --list-blueprints | sort)

choice=$(printf '%s\n' "$menu" | walker --dmenu -p "Theme")
[ -z "$choice" ] && exit 0

# Strip the icon column
choice=$(printf '%s' "$choice" | sed 's/^[^ ]*  //')

case "$choice" in
    auto*)  exec "$themectl" auto ;;
    random) exec "$themectl" random ;;
    *)      exec "$themectl" set "$choice" ;;
esac
