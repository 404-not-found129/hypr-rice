#!/usr/bin/env python3
"""Keybind cheat sheet (Super+/).

Reads the live binds from Hyprland (`hyprctl binds -j`), so it always shows
what is really bound -- including changes and app shortcuts made in the
settings app -- and shows them in a searchable walker menu. Picking an entry
runs it (through the `rice_binds` table hyprland.lua exposes).

  keybinds           menu
  keybinds --print   plain list on stdout
  keybinds --json    [{keys, description}, ...] (used by rice-settings)
"""
import json
import subprocess
import sys

# xkb modifier bits as Hyprland reports them in "modmask"
MODS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]


def keys_of(b):
    mods = [name for bit, name in MODS if b["modmask"] & bit]
    return " + ".join(mods + [b["key"]])


def binds():
    out = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True).stdout
    rows = []
    for b in json.loads(out or "[]"):
        if b.get("description") and not b.get("submap"):
            rows.append({"keys": keys_of(b), "description": b["description"]})
    return rows


def main():
    rows = binds()
    if "--json" in sys.argv:
        print(json.dumps(rows))
        return
    width = max((len(r["keys"]) for r in rows), default=10) + 2
    lines = [f"{r['keys']:<{width}} {r['description']}" for r in rows]
    if "--print" in sys.argv:
        print("\n".join(lines))
        return
    choice = subprocess.run(["walker", "--dmenu", "-p", "Keybinds"], input="\n".join(lines),
                            capture_output=True, text=True).stdout.strip()
    for line, r in zip(lines, rows):
        if line.strip() == choice:
            desc = r["description"].replace("\\", "\\\\").replace('"', '\\"')
            subprocess.run(["hyprctl", "dispatch", f'rice_binds["{desc}"]'], capture_output=True)
            break


if __name__ == "__main__":
    main()
