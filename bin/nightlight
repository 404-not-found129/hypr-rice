#!/bin/bash
# Night light (blue-light filter) via hyprsunset. Super+N toggles it; the
# waybar module calls `nightlight status` and gets JSON back.
#
#   nightlight toggle | on | off | restart | status
# Temperature: temp= in ~/.config/hypr-rice/nightlight (set from the settings
# app), else NIGHTLIGHT_TEMP, else 4000 K.

temp=${NIGHTLIGHT_TEMP:-4000}
conf="$HOME/.config/hypr-rice/nightlight"
if [[ -f $conf ]]; then
    t=$(sed -n 's/^temp=\([0-9]\{4\}\)$/\1/p' "$conf")
    [[ -n $t ]] && temp=$t
fi

running() { pgrep -x hyprsunset >/dev/null; }

on() {
    running && return
    setsid hyprsunset -t "$temp" >/dev/null 2>&1 &
}

off() { pkill -x hyprsunset; }

signal_bar() { pkill -RTMIN+9 waybar 2>/dev/null; }

case "${1:-toggle}" in
    on)     on; signal_bar ;;
    off)    off; signal_bar ;;
    toggle) if running; then off; else on; fi; signal_bar ;;
    status)
        if running; then
            printf '{"text":"󰖔","class":"on","tooltip":"Night light on (%sK)"}\n' "$temp"
        else
            printf '{"text":"󰖨","class":"off","tooltip":"Night light off"}\n'
        fi
        ;;
    restart) if running; then off; sleep 0.3; on; fi; signal_bar ;;
    *) echo "usage: nightlight [toggle|on|off|restart|status]" >&2; exit 1 ;;
esac
