#!/bin/bash
# Cycle wallpapers within the CURRENT theme's collection
# (~/Pictures/wallpapers/collections/<theme>/) through Aether so colors
# follow. The active theme is recorded by themectl. Usage: wallcycle [next|prev|random]

state="$HOME/.config/aether/current-theme"
theme=$(cat "$state" 2>/dev/null)
dir="$HOME/Pictures/wallpapers/collections/$theme"
[ -d "$dir" ] || dir="$HOME/Pictures/wallpapers/collections/elden-ring"

# Shared lock with themectl: never run two aether applies at once.
# Extra presses while one is running are ignored.
exec 9>/tmp/aether-apply.lock
flock -n 9 || exit 0

shopt -s nullglob
walls=("$dir"/*.{jpg,jpeg,png,webp,mp4,webm,mkv,mov,gif})
(( ${#walls[@]} )) || exit 1

# Videos are applied through a poster frame (named <video-stem>-<hash>.jpg),
# so match on the stem as well as the exact name.
cur=$(basename "$(readlink "$HOME/Pictures/wallpapers/wall.png" 2>/dev/null)")
idx=-1
for i in "${!walls[@]}"; do
    b=$(basename "${walls[$i]}")
    [[ $b == "$cur" || $cur == "${b%.*}-"*.jpg ]] && idx=$i && break
done

n=${#walls[@]}
if [[ $1 == prev ]]; then
    idx=$(( (idx - 1 + n) % n ))
elif [[ $1 == random ]]; then
    # any wallpaper except the one showing (when there's a choice)
    (( n > 1 )) && idx=$(( (idx + 1 + RANDOM % (n - 1)) % n )) || idx=0
else
    idx=$(( (idx + 1) % n ))
fi

pick=${walls[$idx]}
case ${pick,,} in
    *.mp4|*.webm|*.mkv|*.mov|*.gif)
        # Aether needs a still to extract colors from; livewall makes one and
        # links the video so the post-apply hook plays it.
        pick=$("$HOME/.local/bin/livewall" poster "$pick") || exit 1 ;;
esac
"$HOME/.local/bin/aether-run" --generate "$pick"
